<?xml version="1.0" ?>
<odoo>

    <record id="mail_activity_view_tree" model="ir.ui.view">
        <field name="name">mail.activity.view.tree</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_tree" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field name="priority" widget="badge" decoration-danger="priority == '1'" decoration-warning="priority == '2'" decoration-success="priority == '3'" optional="show"/>
                <field name="approve_state" optional="show"/>
                <field name="approval_required" optional="hide"/>
                <field name="dias_atraso" optional="show"/>
                <field name="activity_group" optional="hide"/>                
            </field>
        </field>
    </record>

    <record id="mail_activity_view_form_popup" model="ir.ui.view">
        <field name="name">mail.activity.form.activity</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="approval_required" invisible="1" />
                    <!-- <button string="Confirm" name="action_confirm" states="draft" type="object" class="oe_highlight"/>                    
                    <button string="Validate" name="action_validate" states="validate1" type="object" groups="hr_holidays.group_hr_holidays_manager" class="oe_highlight"/>                    
                    <button string="Mark as Draft" name="action_draft" type="object" attrs="{'invisible': ['|', ('can_reset', '=', False), ('state', 'not in', ['confirm', 'refuse'])]}"/> -->
                    <button string="Aprobar" name="action_approve" groups="mail_activity_ux.group_aprobador_de_actividades" type="object" class="oe_highlight" invisible="not approval_required or approve_state != 'confirm'"/>
                    <button string="Rechazar" name="action_refuse" groups="mail_activity_ux.group_aprobador_de_actividades" type="object" class="oe_highlight" invisible="not approval_required or approve_state != 'confirm'"/>
                    <field name="approve_state" widget="statusbar" statusbar_visible="draft,confirm,refuse,validate" invisible="not approval_required"/> 
                </header>
            </xpath>
            <field name="date_deadline" position="after">
                <field name="dias_atraso" />
                <field name="priority" />
                <field name="activity_group" />
            </field>
            <xpath expr="//button[@name='action_done']" position="attributes">
                <attribute name="invisible">approval_required and approve_state in ('confirm', 'validate')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_done_schedule_next']" position="attributes">
                <attribute name="invisible">approval_required and approve_state in ('confirm', 'validate')</attribute>
            </xpath>
            <xpath expr="//sheet" position="after">
            	<div class="oe_chatter">
            		<field name="message_ids" widget="mail_thread"/>
            	</div>
            </xpath>
        </field>
    </record>

    <record id="mail_activity_view_search_ux" model="ir.ui.view">
        <field name="name">mail.activity.boards.view.search</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_search" />
        <field name="arch" type="xml">

            <xpath expr='//filter[@name="activities_upcoming_all"]' position='before'>
                <separator />
                    <filter name="my_activities_filter" string="Mis actividades" domain="[('user_id', '=', uid)]" />
                <separator />
                    <filter name="approve_state_confirm" string="Para Aprobar" domain="[('approve_state', '=', 'confirm')]"/>
                <separator />                    
                    <filter name="estado_terminada" string="Terminadas" domain="[('active', '=', False)]"/>
                    <filter name="estado_todas" string="Todas" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <separator />
                    <filter string="Fecha de Creación" name="creation_date" date="create_date"/>
                    <filter string="Fecha Vencimiento" name="date_deadline" date="date_deadline"/>
                    <filter string="Fecha de Finalización" name="done_date" date="date_done"/>
                    <!-- <filter string="Closed Date" name="close_date" date="date_closed"/> -->
                <separator/>                
            </xpath>

            <xpath expr='//filter[@name="activittype"]' position='after'>
                <filter name="group_estado" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_activity_group" string="Grupo de actividades" context="{'group_by': 'activity_group'}"/>
            </xpath>

        </field>
    </record>

